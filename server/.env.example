# Copy to server/.env (git-ignored) and fill in.
# On the LXC container this file lives at /etc/gong/config.env.
#
# All of this is optional: without Schulportal login and web UI password the
# server starts in setup mode and the web UI shows a setup page (link with
# token in the log). Settings made in the web UI (setup page, Einstellungen →
# Server) are stored in the database and take precedence over this file.

# --- Schulportal Hessen login -------------------------------------------------
SPH_SCHOOL_ID=6128
SPH_USERNAME=vorname.nachname
SPH_PASSWORD=

# --- Web UI login -------------------------------------------------------------
# Create with: dart run bin/hash_password.dart
APP_PASSWORD_HASH=
# Alternative: password in plain text (min. 8 characters). Wins over
# APP_PASSWORD_HASH; on start the server replaces it with APP_PASSWORD_HASH in
# this file if it can write the file (otherwise it is hashed in memory).
APP_PASSWORD=

# --- HTTP server --------------------------------------------------------------
# 127.0.0.1 = only this machine; 0.0.0.0 = reachable in the LAN (LXC container)
HOST=127.0.0.1
PORT=8080
# Directory with the built web UI (empty = API only, or the embedded web UI
# of the Windows/macOS builds)
WEB_DIR=
# Open the web UI in the default browser after start (desktop use)
OPEN_BROWSER=false
# Look for new releases on GitHub every 12 hours (Einstellungen → Server → Update)
UPDATE_CHECK=true
# Set to true when served via HTTPS (reverse proxy), so the cookie is Secure
COOKIE_SECURE=false
# Set to true behind a reverse proxy to rate-limit by X-Forwarded-For
TRUST_PROXY=false
# Days a web UI login stays valid without use
SESSION_TTL_DAYS=30
# Directory for the database (sessions, notification state). On the LXC
# container the service runs in /var/lib/gong, so "." is fine.
DATA_DIR=.

# --- Sync with Schulportal ----------------------------------------------------
# The server keeps all data in sync in the background and stores it in the
# database, so the web UI answers right away (also after a restart and while
# the portal is down). false = load only when the web UI asks for it.
SYNC=true
# Substitutions and homework every N minutes (min. 5); course pages (grades,
# all homework, course details) need one request per course (min. 30)
POLL_INTERVAL_MINUTES=15
GRADES_INTERVAL_MINUTES=120
# Only sync between these hours (local time)
ACTIVE_HOURS=6-22

# --- School meals (Caseda Schulmenü) ---------------------------------------------
# Shows the balance and the own orders on Heute (read-only; ordering stays on
# the Caseda website). Login of the Caseda account; empty = off.
CASEDA_ENABLED=true
CASEDA_URL=https://www.caseda-schulmenue.de
CASEDA_USERNAME=
CASEDA_PASSWORD=
# Balance below this amount (euros) is highlighted
CASEDA_BALANCE_WARNING=10

# --- Push notifications (ntfy) --------------------------------------------------
# Empty NTFY_TOPIC = no notifications. Notifications are sent when the sync
# finds something new.
# On ntfy.sh anyone who knows the topic can read it: use a long random name
# (install.sh --configure suggests one) or a protected topic with NTFY_TOKEN.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
# Address of the web UI for links in notifications, e.g. http://192.168.1.50:8080
APP_URL=
# What to notify about (comma-separated): substitutions, homework, grades
NOTIFY=substitutions,homework,grades
# Include the grade itself in notifications (otherwise only "Neue Note: Fach")
NOTIFY_GRADE_VALUES=false
