# Copy to server/.env (git-ignored) and fill in.
# On the LXC container this file lives at /etc/schulportal-client/config.env.

# --- Schulportal Hessen login -------------------------------------------------
SPH_SCHOOL_ID=6128
SPH_USERNAME=vorname.nachname
SPH_PASSWORD=

# --- Web UI login -------------------------------------------------------------
# Create with: dart run bin/hash_password.dart
APP_PASSWORD_HASH=

# --- HTTP server --------------------------------------------------------------
# 127.0.0.1 = only this machine; 0.0.0.0 = reachable in the LAN (LXC container)
HOST=127.0.0.1
PORT=8080
# Directory with the built web UI (empty = API only)
WEB_DIR=
# Set to true when served via HTTPS (reverse proxy), so the cookie is Secure
COOKIE_SECURE=false
# Set to true behind a reverse proxy to rate-limit by X-Forwarded-For
TRUST_PROXY=false
# Days a web UI login stays valid without use
SESSION_TTL_DAYS=30
