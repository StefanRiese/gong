# Installs updates requested in the web UI (Einstellungen → Server → Update):
# the server (unprivileged) writes the wanted version to update-request, this
# root unit runs install.sh, which downloads, verifies and installs it.
[Unit]
Description=Gong: watch for update requests from the web UI

[Path]
PathExists=/var/lib/gong/update-request
Unit=gong-update.service

[Install]
WantedBy=multi-user.target
