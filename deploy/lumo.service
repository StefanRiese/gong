[Unit]
Description=Schulportal Hessen client (web UI + API)
Documentation=https://github.com/StefanRiese/lumo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lumo
Group=lumo
# Read by systemd as root, so the file can stay root-only (mode 600).
EnvironmentFile=/etc/lumo/config.env
WorkingDirectory=/var/lib/lumo
ExecStart=/opt/lumo/bin/server
# Updates from the web UI go through lumo-update.path (root).
Environment=UPDATER=systemd
Restart=on-failure
RestartSec=5
# 78 = configuration error: do not restart in a loop, fix config.env instead.
RestartPreventExitStatus=78
TimeoutStopSec=15
StateDirectory=lumo
StateDirectoryMode=0750
UMask=0077

# Sandboxing. Needs namespace support: in an unprivileged Proxmox LXC container
# enable "Nesting" (Options → Features). install.sh adds a drop-in that relaxes
# these settings automatically if the container does not support them.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
